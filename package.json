{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "CLI tool for directory scanning, SHA-256 duplicate detection, categorized file organization, and age-based cleanup",
  "type": "module",
  "main": "file-organizer.js",
  "bin": {
    "file-organizer": "./file-organizer.js"
  },
  "scripts": {
    "scan": "node file-organizer.js scan",
